# The Nest accounts site. Run PHP 8.3 here (the parent site's default handler is older).
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php
</IfModule>

Options -Indexes
DirectoryIndex index.html

# Always use HTTPS (Let's Encrypt certificate, renewed by acme.sh on the server; see server/README.md).
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Play: the Character Generator's Play mode at its own address (the page picks the mode from it).
RewriteRule ^play$ Crows_Character_Generator.html [L]

# Never serve dotfiles, logs, or backups, even if one ends up here by accident.
<FilesMatch "(^\.|error_log|\.log$|\.bak$|\.sql$|~$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always unset X-Powered-By
  # Keep both instances out of search engines and caches (the whole domain sends this too, from public_html/.htaccess).
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Change signals (sync/<hash>.txt, rewritten on every save): never cache them anywhere.
  <FilesMatch "^[0-9a-f]{32}\.txt$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# Content-Security-Policy per page, with hashes of the apps' inline scripts (filled in by server/csp.py).
# @CSP@
